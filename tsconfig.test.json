{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "isolatedModules": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": ".test-build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["tests/**/*.ts"],
  "exclude": ["node_modules"]
}
