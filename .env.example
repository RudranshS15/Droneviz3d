# DroneViz3D — environment configuration
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# ── How Next.js env vars work ────────────────────────────────────────────────
#   NEXT_PUBLIC_*   → inlined into the browser bundle. Treat as PUBLIC.
#                     Never put API keys or tokens in these.
#   everything else → server-only, read only inside route handlers. These back
#                     the admin backend and the grounding proxy below.

# ── LocateAnything-3B inference worker (grounding-worker.py) ───────────────
# Browser mode flag — PUBLIC (inlined into the browser bundle, not a secret):
#   NEXT_PUBLIC_GROUNDING_MODE=worker  → real detections via /api/ground
#   (unset)                            → deterministic simulated adapter (no GPU)
# NEXT_PUBLIC_GROUNDING_MODE=

# Server-side only — the browser never sees these. /api/ground proxies requests
# to the worker and injects the token. Generate the token with:
#   openssl rand -hex 32
# and pass it to the worker via WORKER_TOKEN or `--token`.
# WORKER_URL=http://127.0.0.1:8300
# WORKER_TOKEN=

# ── Who owns this installation ──────────────────────────────────────────────
# Comma-separated list of addresses. Only these are admin by default, and they
# are the only accounts allowed to grant admin to anyone else, demote or remove
# a user, or sign their sessions out. They can never be demoted, deleted or
# locked out — by any other admin, by you, or by each other.
# Leave it unset and the installation keeps the older behaviour: the bootstrap
# token decides who may claim the *first* admin, every admin may manage users,
# and the last-admin guard is the only lockout protection.
# This belongs here and not in the source: the repository is public.
# OWNER_EMAILS=

# ── Admin backend (session auth) ────────────────────────────────────────────
# The proof required to claim an admin account (OWNER_EMAILS above says who is
# allowed to). Generate with:  openssl rand -hex 32
# Set it on any deployed instance — without it a public installation refuses
# registration rather than granting admin to whoever's request arrives first.
# After the first admin exists:
#   OWNER_EMAILS unset → the token has done its job; the line can be deleted,
#                        and is never consulted again.
#   OWNER_EMAILS set   → keep it. It is what lets a listed owner claim admin
#                        (e.g. after adding a second owner address), so treat it
#                        as a durable secret.
# Not required for `npm run dev` on your own machine, which keeps the local
# first-run flow.
# ADMIN_BOOTSTRAP_TOKEN=

# Backend (optional): WebSocket URL for a real processing pipeline.
# VITE_* names are Vite conventions — this is a Next.js app, so do NOT use them.
# BACKEND_WS_URL=

# Storage (optional): S3/GCS bucket for exported models.
# STORAGE_BUCKET=
# STORAGE_REGION=

# Auth: unused. The admin backend ships with local session auth (argon2id
# password hashes, CSRF tokens) and needs no OAuth credentials. These are
# reserved for a future SSO provider — leave them unset.
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=

# Deployed at https://... — lets Next.js apply HSTS and a strict CSP automatically.
# NODE_ENV=production is set by `next build`/`next start`; you do not need this here.