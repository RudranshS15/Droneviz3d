# DroneViz3D — environment configuration
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.

# Backend (optional): WebSocket URL for real processing pipeline
# VITE_BACKEND_WS_URL=

# Storage (optional): S3/gcs bucket for uploaded videos and exported models
# VITE_STORAGE_BUCKET=
# VITE_STORAGE_REGION=

# Auth (optional): GitHub/Google OAuth client ID for multi-user accounts
# VITE_AUTH_CLIENT_ID=

# API keys (optional): any external services your deployment needs
