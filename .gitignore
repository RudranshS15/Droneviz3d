# Dependencies
node_modules/

# Build output. `next dev` writes .next/, `next build`/`start` write .next-build/
# so the two can run at the same time (see next.config.js).
.next/
.next-build/
out/
build/

# Environment — never commit real values. Keep only the template.
.env
.env.*
!.env.example

# Secrets & credentials (defense in depth)
*.pem
*.key
*.p12
*.pfx
*.crt
*.jks
*.keystore
credentials.json
service-account*.json

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# VS Code
.vscode/
.idea/

# Start scripts (deployment helpers, not source)
*.bat

# Local test screenshots — never part of the repo
screenshots/

# TypeScript build info
tsconfig.tsbuildinfo

# Next regenerates this on every dev/build, pointing at whichever output
# directory that command uses (.next or .next-build), so tracking it would make
# the working tree dirty depending on the last command run. Next's own guidance
# is that the file is not to be edited.
next-env.d.ts

# Coverage / CI noise
coverage/
.vercel/

# Local database (admin backend) — never commit user data
data/
# Codebuff workspace state
.freebuff/

# Test build output (tsconfig.test.json)
.test-build/
